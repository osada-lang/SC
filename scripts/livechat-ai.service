[Unit]
Description=LiveChat AI Face Swap Auto-Startup Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/SC
ExecStartPre=/bin/bash -c "git pull || true"
ExecStart=/bin/bash -c "source /opt/pytorch/bin/activate && cd /home/ubuntu/SC/server && python3 app.py"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
